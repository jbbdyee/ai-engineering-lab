        }
      }
    },
    {
      "name": "Search FAQ",
      "type": "n8n-nodes-base.httpRequestTool",
      "typeVersion": 4.2,
      "position": [
        580,
        520
      ],
      "parameters": {
        "toolDescription": "사내 IT FAQ를 검색합니다. 비밀번호, 계정 잠김, VPN, 프린터, 메일, 소프트웨어 등 사내 IT 이용 및 문제 해결 질문에 사용합니다. 입력값: 질문의 핵심 IT 키워드(한국어).",
        "url": "http://data-api:8800/faq",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "q",
              "value": "={{ $fromAI('query', '질문의 핵심 IT 키워드(한국어)', 'string') }}"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "name": "Get ticket",
      "type": "n8n-nodes-base.httpRequestTool",
      "typeVersion": 4.2,
      "position": [
        760,
        520
      ],
      "parameters": {
        "toolDescription": "IT 문의 접수 현황을 조회합니다. 질문에 T-1002와 같은 접수 번호가 포함되어 있을 때만 사용하세요. 입력값: 접수 번호.",
        "url": "=http://data-api:8800/tickets/{{ $fromAI('ticket_id', 'T-1002와 같은 접수 번호', 'string') }}",
        "options": {
          "response": {
            "response": {
              "neverError": true
            }
          }
        },
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "requester",
              "value": "={{ $('IT question webhook').first().json.body.user }}"
            }
          ]
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Validate the agent's answer against the tool result before responding.\nconst steps = $json.intermediateSteps ?? [];\nconst answer = String($json.output ?? '').trim();\nconst question = String($('IT question webhook').first().json.body.question ?? '');\nconst toolsUsed = [...new Set(steps.map(step => step.action?.tool).filter(Boolean))];\nconst observations = steps.map(step => typeof step.observation === 'string'\n  ? step.observation : JSON.stringify(step.observation ?? ''));\nconst sources = [...new Set(observations.join('\\n').match(/FAQ-\\d{3}|T-\\d{4}/g) ?? [])];\nconst ticketId = (question.match(/T-\\d{4}/i) || [])[0];\nconst requiredTool = ticketId ? 'Get_ticket' : 'Search_FAQ';\n\nfunction hasActualData(observation) {\n  let data = observation;\n  if (typeof data === 'string') {\n    try { data = JSON.parse(data); } catch { return false; }\n  }\n  if (!data || typeof data !== 'object') return false;\n  if (data.error) return false;\n  if (Array.isArray(data.results)) return data.results.length > 0;\n  return typeof data.ticket_id === 'string' && data.ticket_id.length > 0;\n}\n\nconst found = steps.some(step =>\n  step.action?.tool === requiredTool && hasActualData(step.observation));\nconst checks = [\n  { name: 'answer_not_empty', passed: answer.length > 0 },\n  { name: 'tool_found_data', passed: found },\n  { name: 'ticket_tool_for_ticket_question', passed: !ticketId || toolsUsed.includes('Get_ticket') },\n  { name: 'korean_answer', passed: /[가-힣]/.test(answer) },\n  { name: 'short_answer', passed: answer.length <= 400 },\n];\nconst failed = checks.filter(check => !check.passed).map(check => check.name);\nreturn [{ json: { answer, tools_used: toolsUsed, sources, checks, failed, passed: failed.length === 0 } }];\n"
      },
      "name": "Check answer",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        800,
