    {
      "name": "Join editors",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 3,
      "position": [
        2720,
        270
      ],
      "parameters": {
        "numberInputs": 2
      }
    },
    {
      "name": "Combine",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2940,
        270
      ],
      "parameters": {
        "jsCode": "const base = $('Final notice').first().json;\nconst notice = String(base.notice ?? '');\nconst plain = value => String(value ?? '').trim()\n  .replace(/^\\x60\\x60\\x60(?:[a-z]+)?\\s*|\\x60\\x60\\x60$/gi, '').trim()\n  .replace(/^[\"“”']|[\"“”']$/g, '').trim();\nconst removeContacts = value => value\n  .replace(/01[016789]-?\\d{3,4}-?\\d{4}/g, '')\n  .replace(/[\\w.+-]+@[\\w-]+\\.[\\w.]+/g, '')\n  .replace(/\\(\\s*\\)/g, '')\n  .replace(/[ \\t]{2,}/g, ' ').trim();\nlet title = removeContacts(plain($('Make title').first().json.output))\n  .split(/\\r?\\n/)[0].trim();\nif (!title) title = removeContacts(notice.split(/\\r?\\n/)[0].replace(/^\\[|\\]$/g, '')).trim();\ntitle = title.replace(/[()\\[\\]{}]/g, '').slice(0, 40).trim();\nlet chat = removeContacts(plain($('Make chat message').first().json.output));\nif (!chat) chat = removeContacts(notice.replace(/\\s+/g, ' '));\nconst tokens = [...new Set(notice.match(/\\d{1,2}월\\s*\\d{1,2}일(?:\\([가-힣]\\))?|\\d{1,2}:\\d{2}/g) ?? [])];\nconst missing = tokens.filter(token => !chat.replace(/\\s+/g, '').includes(token.replace(/\\s+/g, '')));\nif (missing.length) chat = missing.join(' ') + ' ' + chat;\nchat = chat.split(/\\r?\\n/).map(line => line.trim()).filter(Boolean).slice(0, 2).join('\\n');\nchat = chat.slice(0, 120).trim();\nreturn [{ json: { ...base, title, chat } }];"
      }
    }
