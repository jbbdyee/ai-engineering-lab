    {
      "name": "Make chat message",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [
        2420,
        430
      ],
      "parameters": {
        "promptType": "define",
        "text": "=검토를 통과한 공지:\n{{ $('Final notice').first().json.notice }}",
        "options": {
          "systemMessage": "당신은 검토를 통과한 IT 공지를 메신저용 짧은 글로 줄이는 정리자입니다. 공지에 있는 사실만 사용하세요. 최대 2줄, 줄바꿈을 포함해 120자 이내로 작성하세요. 공지의 날짜·요일·시간은 쓰는 경우 원문 그대로 옮기고, 중요한 마감일과 점검 시간은 빠뜨리지 마세요. 검토 과정에서 지운 전화번호나 이메일 주소를 되살리지 마세요. 공지에 없는 약속, 보상, 쿠폰, 연락처, 내선번호, 서비스나 일정을 만들어 넣지 마세요. 메신저 글만 출력하고 설명, 따옴표, JSON, 코드 블록은 붙이지 마세요.",
          "maxIterations": 2
        }
      }
    },
    {
      "name": "Chat model",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1.2,
      "position": [
        2400,
        640
      ],
      "parameters": {
        "model": {
