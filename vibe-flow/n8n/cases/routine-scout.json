    {
      "name": "동일 작업 3회",
      "request": {
        "events": [
          {
            "source": "codex",
            "action": "copy",
            "target": "chatgpt"
          },
          {
            "source": "codex",
            "action": "copy",
            "target": "chatgpt"
          },
          {
            "source": "codex",
            "action": "copy",
            "target": "chatgpt"
          }
        ]
      },
      "expect": {
        "status": 200,
        "equals": {
          "status": "recommend",
          "recommendations": [
            {
              "source": "codex",
              "action": "copy",
              "target": "chatgpt",
              "repeat_count": 3,
              "suggestion": "codex에서 chatgpt로 copy하는 반복 작업의 자동화를 추천합니다."
            }
          ],
          "patterns": [
            {
              "source": "codex",
              "action": "copy",
              "target": "chatgpt",
              "repeat_count": 3
            }
          ]
        }
      }
    },
